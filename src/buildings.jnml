{% from 'common.jnml' import AXES, use_default_palette, ground %}
{% from 'spriteset_things.jnml' import THINGS_IDS %}

{% macro init_buildings() -%}
	// Bits we'll use here:
	// 3: End crossing to top platform
	// 4: End crossing to bottom platform
	// 5: End crossing on the top side (as opposed to the bottom side), or prop information if both 3 and 4 are not set
	{% for sign_side, side_id in [('TOP', 4), ('BOTTOM', 0)] -%}
		{% set station_name = 'SINGLE_STATION_SIGN_' + sign_side -%}
		{% set station_id = 32768 + side_id -%}

		{% for axis in AXES -%}
		{% set other_axis = 'X' if axis == 'Y' else 'Y' -%}
		spritelayout spritelayout_{{ station_name }}_{{ axis}}(a) {
			{{ ground() }}

			building {
				sprite: spriteset_things({{ THINGS_IDS['STATION_SIGN_FRONTAL_' + axis] }});
				{{ use_default_palette() }}
				{{ axis|lower }}offset: 8;
				{{ other_axis|lower }}offset: {{ 0 if sign_side == 'TOP' else 12 }};
				zoffset: 0;
				{{ axis|lower }}extent: 0;
				{{ other_axis|lower }}extent: 4;
				zextent: 3;
			}
		}
		{% endfor -%}

		item(FEAT_STATIONS, station_{{ station_name }}, {{ station_id }}) {
			property {
				class: "ROPR";
				classname: string(STR_CLASS_NAME_PASSENGER_BUILDINGS);
				name: string(STR_STATION_NAME_STATION_SIGN);
				cargo_random_triggers: [PASS];
				tile_flags: [bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE)];
				heights: [1, 1, 1, 1];
				badges: [
					"flag/RO",
					"region/europe/eastern",
					"sign/romanian",
				];
			}
			graphics {
				sprite_layouts: [
					spritelayout_{{ station_name }}_Y(0),
					spritelayout_{{ station_name }}_X(0),
				];
			}
		}
	{% endfor -%}

	{% set station_name = 'BALAUSERI' -%}
	{% set station_id = 32768 + 8 -%}

	{% for axis in AXES -%}
	{% set other_axis = 'X' if axis == 'Y' else 'Y' -%}
	spritelayout spritelayout_{{ station_name }}_{{ axis}}(a) {
		{{ ground() }}

		building {
			sprite: spriteset_things({{ THINGS_IDS['BUILDING_BALAUSERI_' + axis] }});
			{{ use_default_palette() }}
			xoffset: 0;
			yoffset: 0;
			zoffset: 0;
			xextent: 16;
			yextent: 16;
			zextent: 16;
		}
	}
	{% endfor -%}

	item(FEAT_STATIONS, station_{{ station_name }}, {{ station_id }}) {
		property {
			class: "ROPR";
			classname: string(STR_CLASS_NAME_PASSENGER_BUILDINGS);
			name: string(STR_STATION_NAME_BALAUSERI);
			cargo_random_triggers: [PASS];
			tile_flags: [bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE), bitmask(STAT_TILE_BLOCKED, STAT_TILE_NOWIRE)];
			badges: [
				"flag/RO",
				"region/europe/eastern",
			];
		}
		graphics {
			sprite_layouts: [
				spritelayout_{{ station_name }}_X(0),
				spritelayout_{{ station_name }}_Y(0),
			];
		}
	}
{% endmacro %}
