{% from 'cargo.jnml' import PASSENGERS_HEIGHT %}
{% from 'common.jnml' import platform_offsets, use_default_palette, use_metal_roof_palette, hide_sprite_building, template_grid %}
{% from 'spriteset_things.jnml' import THINGS_IDS %}

// Props are the various elements that make up the station, such as platforms, benches, etc.
// Buffers are a special case, as unlike the other props, their sprites don't belong to spriteset_things.

{% set POLES_HEIGHT = 8 %}

// Most props' functions accept the following parameters:
// - station_platform_side: The side the station's platform is on (TOP, BOTTOM, or BOTH).
// - platform_position: The platform the prop is on (TOP or BOTTOM). Usually in a layout the prop function will be called with both values, to account for the platform side alternation feature.
// - axis: The axis the station is on (X or Y).
// - platform_height: The height of the platform the prop is on. This usually translates to the zoffset of the prop.

{% macro prop_fence(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['BLACK_YELLOW_FENCE_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building('BOTTOM' if station_platform_side == 'TOP' else 'TOP', platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_station_sign(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['STATION_SIGN_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_bench(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['BENCH_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, PASSENGERS_HEIGHT + (1 if platform_position == 'BOTTOM' else -1), platform_height) }}
	}
{% endmacro %}

{% macro prop_underpass(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['UNDERPASS_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, PASSENGERS_HEIGHT + (1 if platform_position == 'BOTTOM' else -1), platform_height) }}
	}
{% endmacro %}

{% macro prop_crossing(axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['CROSSING_' + axis] }});
		{{ use_default_palette() }}
		{{ platform_offsets('TOP', 'X', 0, 0, other_axis_extent=16) }}
	}
{% endmacro %}

{% macro prop_crossing_new(axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['CROSSING_NEW_' + axis] }});
		{{ use_default_palette() }}
		{{ platform_offsets('TOP', 'X', 0, 0, other_axis_extent=16) }}
	}
{% endmacro %}

{% macro prop_ramp_crossing(station_platform_side, platform_position, axis, platform_side) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['RAMP_CROSSING_' + platform_side + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 3, 0, other_axis_extent=2) }}
	}
{% endmacro %}

{% macro prop_poles(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['POLES_' + (platform_height|string) + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_info_panel(station_platform_side, platform_position, axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['INFO_PANEL_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 2, 3 + POLES_HEIGHT, other_axis_extent=3) }}
	}
	childsprite {
		sprite: spriteset_things({{ THINGS_IDS['INFO_PANEL_TEXT_' + axis] }});
		{{ use_default_palette() }}
		hide_sprite: pbs_reserved == 0;
	}
{% endmacro %}

{% macro prop_metal_roof(station_platform_side, platform_position, axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['METAL_ROOF_' + platform_position + '_' + axis] }});
		{{ use_metal_roof_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 6, 4 + POLES_HEIGHT) }}
	}
{% endmacro %}

{% macro prop_overpass_stairs(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['OVERPASS_STAIRS_' + (platform_height|string) + '_' + platform_position + '_' + axis] }});
		{{ use_metal_roof_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 21, 0) }}
	}
{% endmacro %}

{% macro prop_overpass_poles(station_platform_side, platform_position, axis, platform_height) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['OVERPASS_POLES_' + (platform_height|string) + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_pack_overpass_poles(station_platform_side, axis, platform_height, include_overpass) -%}
	{{ prop_overpass_poles(station_platform_side, 'TOP', axis, platform_height) }}
	{{ prop_overpass_poles(station_platform_side, 'BOTTOM', axis, platform_height) }}
	{% if include_overpass and station_platform_side != 'BOTH' -%}
		{% set other_side = 'TOP' if station_platform_side == 'BOTTOM' else 'BOTTOM' -%}
		{{ prop_overpass_poles(other_side, 'TOP', axis, 0) }}
		{{ prop_overpass_poles(other_side, 'BOTTOM', axis, 0) }}
	{% endif -%}
{% endmacro %}

{% macro prop_overpass(station_platform_side, platform_position, axis) -%}
	{% set other_axis = 'X' if axis == 'Y' else 'Y' -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['OVERPASS_' + ('FOR_TOP_STAIRS_' if platform_position == 'TOP' else '') + axis] }});
		{{ use_metal_roof_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}

		{{ axis|lower }}offset: 6;
		{{ other_axis|lower }}offset: 0;
		zoffset: 13;
		{{ axis|lower }}extent: 4;
		{{ other_axis|lower }}extent: 10;
		zextent: 8;
	}
{% endmacro %}

{% macro prop_pack_overpass(station_platform_side, axis, include_stairs) -%}
	{% if not include_stairs -%}
		{{ prop_overpass('BOTH', 'BOTTOM', axis) }}
	{% else -%}
		{{ prop_overpass(station_platform_side, 'TOP', axis) }}
		{% if station_platform_side != 'BOTH' -%}
			{{ prop_overpass(station_platform_side, 'BOTTOM', axis) }}
		{% endif -%}
	{% endif -%}
{% endmacro %}

{% macro platform_concrete_slabs(station_platform_side, platform_position, axis, modifier='') -%}
	// Platform
	building {
		sprite: CUSTOM({{ 1 if platform_position == 'TOP' else 2 }}, {{ 0 if axis == 'X' else 2 }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 1, 0) }}
	}
{% endmacro %}

{% macro platform_low_asphalt(station_platform_side, platform_position, axis, modifier='') -%}
	// Platform
	building {
		sprite: CUSTOM({{ 1 if platform_position == 'TOP' else 2 }}, {{ 0 if axis == 'X' else 2 }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 1, 0) }}
	}
{% endmacro %}

{% macro platform_high_asphalt(station_platform_side, platform_position, axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['PLATFORM_HIGH_ASPHALT_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 3, 0) }}
	}
{% endmacro %}

{% macro platform_high_asphalt_trackless(station_platform_side, platform_position, axis) -%}
	building {
		sprite: spriteset_things({{ THINGS_IDS['PLATFORM_HIGH_ASPHALT_TRACKLESS_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 3, 0) }}
	}
{% endmacro %}

// Initially, I used childsprites that overrode the edge stripes of the low platforms, but using `nearby_tile_perpendicular` in the `hide_sprite` logic of the childsprites messes up the purchase view.
// So we have to use switches instead.
// Some odd phenomena occur with the X axis platforms that make them use a different index in the spriteset than the specified one
// (probably related to the issue that made me use only Y-oriented passengers for the full tile stations)
// I decided to make different sprites for every possible platform position and crossing presence, with no childsprites.
// (realized too late the switches solution below could theoretically work with childsprites as well)

// The spritesets have the indeces:
// 0, 1: The X sprite
// 2: The Y sprite
{% macro switches_low_platforms(platform_type, image_row, image_path) -%}
	{% for platform_side in ['TOP', 'BOTTOM'] -%}
	{% for modifier in ['', '_CROSSING'] -%}
		{% set platform_name = 'platform_' + platform_type + '_' + platform_side + modifier -%}

		spriteset(spriteset_{{ platform_name }}_end, "{{ image_path }}") {
			{{ template_grid(
				image_row + (2 if modifier == '_CROSSING' else 0),
				1 + (2 if modifier == '_CROSSING' and platform_side == 'BOTTOM' else 0),
				1,
			) }}
			{{ template_grid(
				image_row + (2 if modifier == '_CROSSING' else 0),
				1 + (2 if modifier == '_CROSSING' and platform_side == 'BOTTOM' else 0),
				1,
			) }}
			{{ template_grid(
				image_row + (2 if modifier == '_CROSSING' else 0),
				2 + (2 if modifier == '_CROSSING' and platform_side == 'BOTTOM' else 0),
				1,
			) }}
		}
		spriteset(spriteset_{{ platform_name }}_continuous, "{{ image_path }}") {
			{{ template_grid(
				image_row + 1 + (2 if modifier == '_CROSSING' else 0),
				1 + (2 if platform_side == 'BOTTOM' else 0),
				1,
			) }}
			{{ template_grid(
				image_row + 1 + (2 if modifier == '_CROSSING' else 0),
				1 + (2 if platform_side == 'BOTTOM' else 0),
				1,
			) }}
			{{ template_grid(
				image_row + 1 + (2 if modifier == '_CROSSING' else 0),
				2 + (2 if platform_side == 'BOTTOM' else 0),
				1,
			) }}
		}

		switch(
			FEAT_STATIONS,
			SELF,
			switch_{{ platform_name }},
			(platform_number_from_{{ 'start' if platform_side == 'TOP' else 'end' }}(PLATFORM_SAME_STATION) == 0) || nearby_tile_perpendicular(0, {{ '-1' if platform_side == 'TOP' else '1' }}) == 1,
		) {
			0: return spriteset_{{ platform_name }}_continuous;
			return spriteset_{{ platform_name }}_end;
		}
	{% endfor -%}
	{% endfor -%}
{% endmacro %}
