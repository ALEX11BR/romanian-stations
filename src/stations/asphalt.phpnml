<?php function asphalt_platform(string $axis, string $platform_position, string $layout_position) { ?>
	building {
		sprite: spriteset_things(<?= constant("THING_ASPHALT_PLATFORM_".strtoupper($platform_position)."_{$axis}") ?>);
		<?php use_default_palette() ?>

		<?php hide_building_logic($platform_position, $layout_position) ?>

		<?php ("platform_{$platform_position}_{$axis}_offsets")(ASPHALT_HEIGHT, 0) ?>
	}
	<?php passengers($axis, $platform_position, $layout_position, ASPHALT_HEIGHT) ?>
<?php } ?>

<?php $id = 5; ?>
<?php foreach (['', '_metal_roof', '_underpass', '_underpass_metal_roof', '_bench', '_bench_metal_roof'] as $station_props) { ?>
	<?php foreach (PLATFORMS_POSITIONS as $platforms_position) { ?>
		<?php $block_name_base = "asphalt{$station_props}_{$platforms_position}"; ?>
		<?php foreach (AXES as $axis) { ?>
			spritelayout spritelayout_<?= $block_name_base ?>_<?= $axis ?> {
				<?php ground_rail($axis) ?>
				<?php ("buffers_{$axis}")() ?>

				<?php
					asphalt_platform($axis, 'top', $platforms_position);
					asphalt_platform($axis, 'bottom', $platforms_position);

					if (str_starts_with($station_props, '_underpass')) {
						underpass_building($axis, 'top', $platforms_position, ASPHALT_HEIGHT);
						underpass_building($axis, 'bottom', $platforms_position, ASPHALT_HEIGHT);
					}

					if (str_starts_with($station_props, '_bench')) {
						bench_building($axis, 'top', $platforms_position, ASPHALT_HEIGHT);
						bench_building($axis, 'bottom', $platforms_position, ASPHALT_HEIGHT);
					}

					if (str_ends_with($station_props, '_metal_roof')) {
						metal_roof($axis, 'top', $platforms_position, ASPHALT_HEIGHT);
						metal_roof($axis, 'bottom', $platforms_position, ASPHALT_HEIGHT);
						poles($axis, 'top', $platforms_position, ASPHALT_HEIGHT);
						poles($axis, 'bottom', $platforms_position, ASPHALT_HEIGHT);
					}

					if ($platforms_position !== 'both') {
						$layout_position = $platforms_position === 'top' ? 'bottom' : 'top';
						rail_fence($axis, 'top', $layout_position, 0);
						rail_fence($axis, 'bottom', $layout_position, 0);
					}
				?>
			}
		<?php } ?>

		item(FEAT_STATIONS, station_<?= $block_name_base ?>, <?= $id++ ?>) {
			property {
				class: "ap\01\01";
				classname: string(STR_CLASS_NAME_PASSENGERS);
				name: string(STR_STATION_NAME_ASPHALT<?= strtoupper($station_props) ?>_<?= strtoupper($platforms_position) ?>);
			}
			graphics {
				sprite_layouts: [spritelayout_<?= $block_name_base ?>_X, spritelayout_<?= $block_name_base ?>_Y];
				custom_spritesets: [switch_buffer];

				<?php if ($platforms_position !== 'both') { ?>
					select_tile_type: switch_tile_type;
				<?php } ?>

				random_switch_passengers_level_<?= $id == 'both' ? 2 : 1 ?>;
			}
		}
	<?php } ?>
<?php } ?>
