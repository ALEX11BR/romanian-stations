		{{ template_grid(1, 4, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_FULL_HIGH_ASPHALT': THINGS_IDS|length}) -%}
		{{ template_grid(2, 5, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TRACKLESS_X': THINGS_IDS|length}) -%}
