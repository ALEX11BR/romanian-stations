{% from 'common.jnml' import template_grid %}

{% set THINGS_IDS = {} %}
{% macro init_spriteset_things() %}
	spriteset(spriteset_things, "img/things.png") {
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 3, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 4, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 3, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 4, 1, filename="img/concrete_slab_platforms.png") }}

		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 1, filename="img/asphalt_platforms.png") }}
