		{{ template_grid(5, 1, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 2, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 3, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 4, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_FULL_LOW_ASPHALT': THINGS_IDS|length}) -%}
		{{ template_grid(3, 5, 1, filename="img/asphalt_platforms.png") }}

		{%- do THINGS_IDS.update({'CROSSING_X': THINGS_IDS|length}) -%}
		{{ template_grid(6, 1, 0) }}
		{%- do THINGS_IDS.update({'CROSSING_Y': THINGS_IDS|length}) -%}
		{{ template_grid(6, 2, 0) }}
		{%- do THINGS_IDS.update({'CROSSING_NEW_X': THINGS_IDS|length}) -%}
		{{ template_grid(6, 3, 0) }}
		{%- do THINGS_IDS.update({'CROSSING_NEW_Y': THINGS_IDS|length}) -%}
		{{ template_grid(6, 4, 0) }}
		{%- do THINGS_IDS.update({'RAMP_CROSSING_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 1, 3) }}
		{%- do THINGS_IDS.update({'RAMP_CROSSING_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 2, 3) }}
		{%- do THINGS_IDS.update({'RAMP_CROSSING_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 3, 0) }}
		{%- do THINGS_IDS.update({'RAMP_CROSSING_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 4, 0) }}


		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 3, 3, filename="img/asphalt_platforms.png") }}
