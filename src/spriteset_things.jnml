{% from 'common.jnml' import template_grid %}

{% set THINGS_IDS = {} %}
{% macro init_spriteset_things() %}
	spriteset(spriteset_things, "img/things.png") {
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 1) }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 1) }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 1, offset_x=0, offset_y=0) }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 1, offset_x=0, offset_y=0) }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 3, 1, offset_x=0, offset_y=0) }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 4, 1, offset_x=0, offset_y=0) }}

		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 1, 3) }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 2, 3) }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 3, 3) }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 4, 3) }}

		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_X': THINGS_IDS|length}) -%}
		{{ template_grid(10, 1, 6, left_overflow=1) }}
		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_Y': THINGS_IDS|length}) -%}
		{{ template_grid(10, 2, 6, right_overflow=1) }}

		{%- do THINGS_IDS.update({'STATION_SIGN_X': THINGS_IDS|length}) -%}
		{{ template_grid(11, 1, 0) }}
		{%- do THINGS_IDS.update({'STATION_SIGN_Y': THINGS_IDS|length}) -%}
		{{ template_grid(11, 2, 0) }}

		{%- do THINGS_IDS.update({'POLES_X': THINGS_IDS|length}) -%}
		{{ template_grid(13, 1, 9, left_overflow=1) }}
		{%- do THINGS_IDS.update({'POLES_Y': THINGS_IDS|length}) -%}
		{{ template_grid(13, 2, 9, right_overflow=1) }}

		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(14, 1, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(14, 2, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(14, 3, 7) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(14, 4, 7) }}

		{%- do THINGS_IDS.update({'BENCH_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(15, 1, 0) }}
		{%- do THINGS_IDS.update({'BENCH_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(15, 2, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(15, 3, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(15, 4, 0) }}

		{%- do THINGS_IDS.update({'UNDERPASS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(16, 1, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(16, 2, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(16, 3, 0) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(16, 4, 0) }}
	}
{%- endmacro %}
