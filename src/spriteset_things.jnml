		{{ template_grid(9, 4, 15, filename="img/overpass.png") }}

		{%- do THINGS_IDS.update({'OVERPASS_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 7, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 7, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_FOR_TOP_STAIRS_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 3, 7, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_FOR_TOP_STAIRS_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 4, 7, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_POLES_3_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 3, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_POLES_3_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 3, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_POLES_1_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 5, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_POLES_1_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 5, filename="img/overpass.png") }}
