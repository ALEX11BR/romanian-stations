{% from 'common.jnml' import template_grid %}

{% set THINGS_IDS = {} %}
{% macro init_spriteset_things() %}
	spriteset(spriteset_things, "img/things.png") {
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 3, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_CONCRETE_SLABS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 4, 1, offset_x=0, offset_y=0, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 3, 1, filename="img/concrete_slab_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_CONCRETE_SLABS_CROSSING_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 4, 1, filename="img/concrete_slab_platforms.png") }}

		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_LOW_ASPHALT_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 1, 1, offset_x=0, offset_y=0, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_LOW_ASPHALT_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 2, 1, offset_x=0, offset_y=0, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_LOW_ASPHALT_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 3, 1, offset_x=0, offset_y=0, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_OVERLAY_LOW_ASPHALT_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 4, 1, offset_x=0, offset_y=0, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 1, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 2, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 3, 1, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_LOW_ASPHALT_CROSSING_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 4, 1, filename="img/asphalt_platforms.png") }}

		{%- do THINGS_IDS.update({'CROSSING_X': THINGS_IDS|length}) -%}
		{{ template_grid(6, 1, 0) }}
		{%- do THINGS_IDS.update({'CROSSING_Y': THINGS_IDS|length}) -%}
		{{ template_grid(6, 2, 0) }}

		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 3, 3, filename="img/asphalt_platforms.png") }}
		{%- do THINGS_IDS.update({'PLATFORM_HIGH_ASPHALT_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 4, 3, filename="img/asphalt_platforms.png") }}

		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 3, 6, left_overflow=1) }}
		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 4, 6, right_overflow=1) }}

		{%- do THINGS_IDS.update({'STATION_SIGN_X': THINGS_IDS|length}) -%}
		{{ template_grid(6, 3, 0) }}
		{%- do THINGS_IDS.update({'STATION_SIGN_Y': THINGS_IDS|length}) -%}
		{{ template_grid(6, 3, 0) }}

		{%- do THINGS_IDS.update({'POLES_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 9, left_overflow=1) }}
		{%- do THINGS_IDS.update({'POLES_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 9, right_overflow=1) }}

		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 3, 7) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 4, 7) }}

		{%- do THINGS_IDS.update({'BENCH_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 0) }}
		{%- do THINGS_IDS.update({'BENCH_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 3, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 4, 0) }}

		{%- do THINGS_IDS.update({'UNDERPASS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 1, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 2, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 3, 0) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 4, 0) }}
	}
{%- endmacro %}
