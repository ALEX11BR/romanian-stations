		{{ template_grid(2, 2, 3, filename="img/asphalt_platforms.png") }}

		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_X': THINGS_IDS|length}) -%}
		{{ template_grid(8, 1, 6, left_overflow=1) }}
		{%- do THINGS_IDS.update({'BLACK_YELLOW_FENCE_Y': THINGS_IDS|length}) -%}
		{{ template_grid(8, 2, 6, right_overflow=1) }}

		{%- do THINGS_IDS.update({'STATION_SIGN_X': THINGS_IDS|length}) -%}
		{{ template_grid(10, 1, 0) }}
		{%- do THINGS_IDS.update({'STATION_SIGN_Y': THINGS_IDS|length}) -%}
		{{ template_grid(10, 2, 0) }}
		{%- do THINGS_IDS.update({'STATION_SIGN_FRONTAL_X': THINGS_IDS|length}) -%}
		{{ template_grid(10, 3, 4) }}
		{%- do THINGS_IDS.update({'STATION_SIGN_FRONTAL_Y': THINGS_IDS|length}) -%}
		{{ template_grid(10, 4, 4) }}
		{%- do THINGS_IDS.update({'WHITE_SIGN_FRONTAL_X': THINGS_IDS|length}) -%}
		{{ template_grid(11, 3, 3) }}
		{%- do THINGS_IDS.update({'WHITE_SIGN_FRONTAL_Y': THINGS_IDS|length}) -%}
		{{ template_grid(11, 4, 3) }}

		{%- do THINGS_IDS.update({'POLES_3_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 1, 10, left_overflow=1) }}
		{%- do THINGS_IDS.update({'POLES_3_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 2, 10, right_overflow=1) }}
		{%- do THINGS_IDS.update({'POLES_1_X': THINGS_IDS|length}) -%}
		{{ template_grid(1, 3, 12, left_overflow=1) }}
		{%- do THINGS_IDS.update({'POLES_1_Y': THINGS_IDS|length}) -%}
		{{ template_grid(1, 4, 12, right_overflow=1) }}

		{%- do THINGS_IDS.update({'INFO_PANEL_X': THINGS_IDS|length}) -%}
		{{ template_grid(7, 1, 2) }}
		{%- do THINGS_IDS.update({'INFO_PANEL_Y': THINGS_IDS|length}) -%}
		{{ template_grid(7, 2, 2) }}
		{%- do THINGS_IDS.update({'INFO_PANEL_TEXT_X': THINGS_IDS|length}) -%}
		{{ template_grid(7, 3, 2, offset_x=0, offset_y=0) }}
		{%- do THINGS_IDS.update({'INFO_PANEL_TEXT_Y': THINGS_IDS|length}) -%}
		{{ template_grid(7, 4, 2, offset_x=0, offset_y=0) }}

		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 1, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 2, 4) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(2, 3, 7) }}
		{%- do THINGS_IDS.update({'METAL_ROOF_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(2, 4, 7) }}

		{%- do THINGS_IDS.update({'BENCH_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 1, 0) }}
		{%- do THINGS_IDS.update({'BENCH_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 2, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(3, 3, 0) }}
		{%- do THINGS_IDS.update({'BENCH_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(3, 4, 0) }}

		{%- do THINGS_IDS.update({'UNDERPASS_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 1, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 2, 1) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(4, 3, 0) }}
		{%- do THINGS_IDS.update({'UNDERPASS_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(4, 4, 0) }}

		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 1, 14, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 2, 14, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(5, 3, 11, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(5, 4, 11, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_FINAL_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(11, 1, 0, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_FINAL_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(11, 2, 0, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_FINAL_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(11, 3, 15, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_3_FINAL_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(11, 4, 15, filename="img/overpass.png") }}

		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_TOP_X': THINGS_IDS|length}) -%}
		{{ template_grid(7, 1, 14, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_TOP_Y': THINGS_IDS|length}) -%}
		{{ template_grid(7, 2, 14, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(7, 3, 11, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(7, 4, 11, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_FINAL_BOTTOM_Y': THINGS_IDS|length}) -%}
		{{ template_grid(9, 1, 0, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_FINAL_BOTTOM_X': THINGS_IDS|length}) -%}
		{{ template_grid(9, 2, 0, filename="img/overpass.png") }}
		{%- do THINGS_IDS.update({'OVERPASS_STAIRS_1_FINAL_TOP_Y': THINGS_IDS|length}) -%}
