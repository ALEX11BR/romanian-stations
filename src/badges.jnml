{% from 'common.jnml' import template_grid %}

{% macro init_badges() %}
	badgetable {
		// Benches already have a badge defined by Polish Stations, so we'll use it
		"benches",
		"benches/romanian",

		// Fenches already have a badge defined by Polish Stations, so we'll use it
		"fence",
		"fence/between_tracks",

		// Builtin badge
		"flag/RO",

		"platform_crossing",
		"platform_crossing/level/concrete_modern",
		"platform_crossing/level/concrete_slabs",
		"platform_crossing/underpass",
		"platform_crossing/overpass",

		"platform_side",
		"platform_side/top",
		"platform_side/bottom",
		"platform_side/both",

		"platform_type",
		"platform_type/concrete_slabs",
		"platform_type/low_asphalt",
		"platform_type/high_asphalt",

		// Builtin badge
		"region/europe/eastern",

		// Builtin badge
		"role/passenger",

		// Roofs already have a badge defined by Polish Stations, so we'll use it
		"roof",
		"roof/metal",

		// Info panels already have a badge defined by Polish Stations, so we'll use it
		"screen",
		"screen/romanian",

		"sign",
		"sign/romanian",
	}

	spriteset(spriteset_badge_platform_side_top, "img/badges.png") {
		{{ template_grid(1, 1, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_side_bottom, "img/badges.png") {
		{{ template_grid(1, 2, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_side_both, "img/badges.png") {
		{{ template_grid(1, 3, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_benches_romanian, "img/badges.png") {
		{{ template_grid(3, 1, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_screen_romanian, "img/badges.png") {
		{{ template_grid(3, 2, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_roof_metal, "img/badges.png") {
		{{ template_grid(3, 3, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_sign_romanian, "img/badges.png") {
		{{ template_grid(3, 4, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_fence_between_tracks, "img/badges.png") {
		{{ template_grid(3, 5, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_crossing_level, "img/badges.png") {
		{{ template_grid(4, 1, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_crossing_level_new, "img/badges.png") {
		{{ template_grid(4, 4, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_crossing_underpass, "img/badges.png") {
		{{ template_grid(4, 2, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_crossing_overpass, "img/badges.png") {
		{{ template_grid(4, 3, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_type_concrete_slabs, "img/badges.png") {
		{{ template_grid(5, 1, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_type_low_asphalt, "img/badges.png") {
		{{ template_grid(5, 2, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	spriteset(spriteset_badge_platform_type_high_asphalt, "img/badges.png") {
		{{ template_grid(5, 3, 0, offset_x=0, offset_y=0, width=12, height=12) }}
	}

	if (openttd_version >= version_openttd(15, 0)) {
		item(FEAT_BADGES, badge_benches) {
			property {
				label: "benches";
				name: string(STR_BADGE_BENCHES);
			}
		}
		item(FEAT_BADGES, badge_benches_romanian) {
			property {
				label: "benches/romanian";
				name: string(STR_BADGE_BENCHES_ROMANIAN);
			}
			graphics {
				default: spriteset_badge_benches_romanian;
			}
		}

		item(FEAT_BADGES, badge_fence) {
			property {
				label: "fence";
				name: string(STR_BADGE_FENCE);
			}
		}
		item(FEAT_BADGES, badge_fence_between_tracks) {
			property {
				label: "fence/between_tracks";
				name: string(STR_BADGE_FENCE_BETWEEN_TRACKS);
			}
			graphics {
				default: spriteset_badge_fence_between_tracks;
			}
		}

		item(FEAT_BADGES, badge_platform_crossing) {
			property {
				label: "platform_crossing";
				name: string(STR_BADGE_PLATFORM_CROSSING);
			}
		}
		item(FEAT_BADGES, badge_platform_crossing_level) {
			property {
				label: "platform_crossing/level/concrete_slabs";
				name: string(STR_BADGE_PLATFORM_CROSSING_LEVEL);
			}
			graphics {
				default: spriteset_badge_platform_crossing_level;
			}
		}
		item(FEAT_BADGES, badge_platform_crossing_level_new) {
			property {
				label: "platform_crossing/level/concrete_modern";
				name: string(STR_BADGE_PLATFORM_CROSSING_LEVEL_NEW);
			}
			graphics {
				default: spriteset_badge_platform_crossing_level_new;
			}
		}
		item(FEAT_BADGES, badge_platform_crossing_underpass) {
			property {
				label: "platform_crossing/underpass";
				name: string(STR_BADGE_PLATFORM_CROSSING_UNDERPASS);
			}
			graphics {
				default: spriteset_badge_platform_crossing_underpass;
			}
		}
		item(FEAT_BADGES, badge_platform_crossing_overpass) {
			property {
				label: "platform_crossing/overpass";
				name: string(STR_BADGE_PLATFORM_CROSSING_OVERPASS);
			}
			graphics {
				default: spriteset_badge_platform_crossing_overpass;
			}
		}

		item(FEAT_BADGES, badge_platform_side) {
			property {
				label: "platform_side";
				name: string(STR_BADGE_PLATFORM_SIDE);
			}
		}
		item(FEAT_BADGES, badge_platform_side_top) {
			property {
				label: "platform_side/top";
				name: string(STR_BADGE_PLATFORM_SIDE_TOP);
			}
			graphics {
				default: spriteset_badge_platform_side_top;
			}
		}
		item(FEAT_BADGES, badge_platform_side_bottom) {
			property {
				label: "platform_side/bottom";
				name: string(STR_BADGE_PLATFORM_SIDE_BOTTOM);
			}
			graphics {
				default: spriteset_badge_platform_side_bottom;
			}
		}
		item(FEAT_BADGES, badge_platform_side_both) {
			property {
				label: "platform_side/both";
				name: string(STR_BADGE_PLATFORM_SIDE_BOTH);
			}
			graphics {
				default: spriteset_badge_platform_side_both;
			}
		}

		item(FEAT_BADGES, badge_platform_type) {
			property {
				label: "platform_type";
				name: string(STR_BADGE_PLATFORM_TYPE);
			}
		}
		item(FEAT_BADGES, badge_platform_type_concrete_slabs) {
			property {
				label: "platform_type/concrete_slabs";
				name: string(STR_BADGE_PLATFORM_TYPE_CONCRETE_SLABS);
			}
			graphics {
				default: spriteset_badge_platform_type_concrete_slabs;
			}
		}
		item(FEAT_BADGES, badge_platform_type_low_asphalt) {
			property {
				label: "platform_type/low_asphalt";
				name: string(STR_BADGE_PLATFORM_TYPE_LOW_ASPHALT);
			}
			graphics {
				default: spriteset_badge_platform_type_low_asphalt;
			}
		}
		item(FEAT_BADGES, badge_platform_type_high_asphalt) {
			property {
				label: "platform_type/high_asphalt";
				name: string(STR_BADGE_PLATFORM_TYPE_HIGH_ASPHALT);
			}
			graphics {
				default: spriteset_badge_platform_type_high_asphalt;
			}
		}

		item(FEAT_BADGES, badge_roof) {
			property {
				label: "roof";
				name: string(STR_BADGE_ROOF);
			}
		}
		item(FEAT_BADGES, badge_roof_metal) {
			property {
				label: "roof/metal";
				name: string(STR_BADGE_ROOF_METAL);
			}
			graphics {
				default: spriteset_badge_roof_metal;
			}
		}

		item(FEAT_BADGES, badge_screen) {
			property {
				label: "screen";
				name: string(STR_BADGE_SCREEN);
			}
		}
		item(FEAT_BADGES, badge_screen_romanian) {
			property {
				label: "screen/romanian";
				name: string(STR_BADGE_SCREEN_ROMANIAN);
			}
			graphics {
				default: spriteset_badge_screen_romanian;
			}
		}

		item(FEAT_BADGES, badge_sign) {
			property {
				label: "sign";
				name: string(STR_BADGE_SIGN);
			}
		}
		item(FEAT_BADGES, badge_sign_romanian) {
			property {
				label: "sign/romanian";
				name: string(STR_BADGE_SIGN_ROMANIAN);
			}
			graphics {
				default: spriteset_badge_sign_romanian;
			}
		}
	}
{% endmacro %}
