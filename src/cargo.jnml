{% from 'common.jnml' import AXES, STATION_PLATFORM_SIDES, platform_offsets, use_default_palette, ground_rail, template_grid, hide_sprite_building %}

{% set PASSENGERS_HEIGHT = 6 %}

{% macro cargo_passengers(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: DEFAULT({{'0' if axis == 'X' else '1'}});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, PASSENGERS_HEIGHT, platform_height) }}
	}
{% endmacro %}

// We compute the number of passengers that should be displayed on a tile as passengers_waiting / tiles_of_station.
// platform_count * platform_length is a good approximation for the number of tiles in a station.
// As the numbers will not divide exactly, the decimal part represents a probability to ceil up the division result (this would be the case if we simply added the seed in the final formula).
// We allow the possibility for the number of passengers per tile to go up or down by 1 by instead adding in the final formula {seed * 3 - 15}
// To simulate the decimals, we do a multiplication by 16 (0-15 is the range of the random seed).
// We divide by an extra 2 if we have a tile with two platforms, besides the 16 for coming back to integer space.

// Using STAT_FLAG_DISTRIBUTED_CARGO has some drawbacks:
// - all the platforms will have their passengers sprite updated at the same time
// - the preview icon in the station build window will show the maximum number of passengers when using `spritegroup`s

// For whatever reason, `/ (platform_length(PLATFORM_SAME_STATION) * platform_count(PLATFORM_SAME_STATION))` breaks the formula in a way `platform_length(PLATFORM_SAME_STATION) / platform_count(PLATFORM_SAME_STATION)` does not
{% macro init_cargo() %}
	{% for i in range(1, 10) %}
		spriteset(spriteset_passengers_{{ i }}, "img/passengers.png") {
			{{ template_grid(i, 1, PASSENGERS_HEIGHT) }}
			{{ template_grid(i, 2, PASSENGERS_HEIGHT) }}
		}
	{% endfor %}

	{% for platforms_per_tile in range(1, 3) %}
		{% for seed in range(16) %}
			switch(
				FEAT_STATIONS,
				SELF,
				switch_passengers_{{platforms_per_tile}}_{{seed}},
				cargo_amount_waiting(PASS) == 0 ? 0 : max(0, (cargo_amount_waiting(PASS) * 16 / platform_length(PLATFORM_SAME_STATION) / platform_count(PLATFORM_SAME_STATION) + {{ seed * 3 - 15 }}) / (16 * {{ platforms_per_tile }}))
			) {
				0: spriteset_empty;
				1: spriteset_passengers_1;
				2: spriteset_passengers_2;
				3..4: spriteset_passengers_3;
				5..7: spriteset_passengers_4;
				8..10: spriteset_passengers_5;
				11..13: spriteset_passengers_6;
				14..16: spriteset_passengers_7;
				17..19: spriteset_passengers_8;
				return spriteset_passengers_9;
			}
		{% endfor %}

		random_switch(
			FEAT_STATIONS,
			TILE,
			random_switch_passengers_{{ platforms_per_tile }},
			TRIGGER_ALL_NEEDED
		) {
			{% for seed in range(16) %}
				1: switch_passengers_{{ platforms_per_tile }}_{{ seed }};
			{% endfor %}
		}
	{% endfor %}
{%- endmacro %}
