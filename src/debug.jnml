{% from 'common.jnml' import template_grid %}

{% macro init_debug() %}
    {% for i in range(1, 17) %}
        spriteset(spriteset_debug_{{ i }}, "img/debug.png") {
            {{ template_grid(i, 1, 0) }}
            {{ template_grid(i, 1, 0) }}
        }
    {% endfor %}

    random_switch(
        FEAT_STATIONS,
        TILE,
        random_switch_debug,
        TRIGGER_ALL_NEEDED
    ) {
        {% for seed in range(16) %}
            1: spriteset_debug_{{ seed + 1 }};
        {% endfor %}
    }
{% endmacro %}
