{% from 'common.jnml' import template_grid, ground_rail, platform_offsets %}
{% from 'badges.jnml' import init_badges %}

grf {
	grfid: "ap\00\00";
	name: string(DEBUG);
	desc: string(DEBUG);
	version: 1;
	min_compatible_version: 1;
}

cargotable {
	PASS
}

{{ init_badges() }}

{% for i in range(1, 17) %}
spriteset(spriteset_debug_{{ i }}, "img/debug.png") {
    {{ template_grid(i, 1, 0) }}
    {{ template_grid(i, 1, 0) }}
}
{% endfor %}

random_switch(
    FEAT_STATIONS,
    TILE,
    random_switch_debug,
    TRIGGER_ALL_NEEDED
) {
{% for seed in range(16) %}
    1: spriteset_debug_{{ seed + 1 }};
{% endfor %}
}

spritelayout spritelayout_debug_X {
    {{ ground_rail('X') }}
    building {
        sprite: DEFAULT(0);
        {{ platform_offsets('TOP', 'X', 0, 0) }}
    }
}

spritelayout spritelayout_debug_Y {
    {{ ground_rail('Y') }}
    building {
        sprite: DEFAULT(1);
        {{ platform_offsets('TOP', 'Y', 0, 0) }}
    }
}


item(FEAT_STATIONS, station_debug, 0) {
    property {
        class: "ap\00\00";
        classname: string(DEBUG);
        name: string(DEBUG);
        cargo_random_triggers: [PASS];
        heights: [1, 1, 1, 1];
        badges: ["benches/romanian"];
    }
    graphics {
        sprite_layouts: [
            spritelayout_debug_X,
            spritelayout_debug_Y
        ];
        random_switch_debug;
    }
}

item(FEAT_STATIONS, station_debug_2, 1) {
    property {
        class: "ap\00\00";
        classname: string(DEBUG);
        name: string(DEBUG);
        cargo_random_triggers: [PASS];
        heights: [1, 1, 1, 1];
        //badges: ["benches/romanian"];
    }
    graphics {
        sprite_layouts: [
            spritelayout_debug_X,
            spritelayout_debug_Y
        ];
        random_switch_debug;
    }
}

	{% for platform_type, platform_height, platform_type_id in [
		('CONCRETE_SLABS', 1, 0),
		('LOW_ASPHALT', 1, 128),
		('HIGH_ASPHALT', 3, 128 + 256)
	] -%}

	{% for platform_prop, platform_prop_height_restriction, platform_prop_id in [
		('', 0, 0),
		('_BENCH', 1, 16),
		('_CROSSING', 3, 32),
		('_UNDERPASS', 1, 48),
		('_OVERPASS', 0, 64),
	] if platform_prop_height_restriction != platform_height -%}

	{% for high_prop, high_prop_id in [
		('', 0),
		('_INFO_PANEL', 8),
	] if high_prop == '' or platform_type != 'CONCRETE_SLABS' -%}

	{% for roof_prop, roof_prop_id in [
		('', 0),
		('_METAL_ROOF', 4),
	] if roof_prop == '' or platform_height == 3 -%}

	{% for station_platform_side, platforms_id in STATION_PLATFORM_SIDES -%}
