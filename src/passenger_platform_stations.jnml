{% from 'buffers.jnml' import buffers %}
{% from 'cargo.jnml' import PASSENGERS_HEIGHT, cargo_passengers %}
{% from 'common.jnml' import AXES, STATION_PLATFORM_SIDES, platform_offsets, use_default_palette, use_metal_roof_palette, ground_rail, hide_sprite_building %}
{% from 'spriteset_things.jnml' import THINGS_IDS %}

{% macro prop_fence(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['BLACK_YELLOW_FENCE_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building('BOTTOM' if station_platform_side == 'TOP' else 'TOP', platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_station_sign(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['STATION_SIGN_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_bench(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['BENCH_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, PASSENGERS_HEIGHT + (1 if platform_position == 'BOTTOM' else -1), platform_height) }}
	}
{% endmacro %}

{% macro prop_underpass(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['UNDERPASS_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, PASSENGERS_HEIGHT + (1 if platform_position == 'BOTTOM' else -1), platform_height) }}
	}
{% endmacro %}

{% macro prop_crossing(axis) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['CROSSING_' + axis] }});
		{{ use_default_palette() }}
		{{ platform_offsets('TOP', 'X', 0, 0, other_axis_extent=16) }}
	}
{% endmacro %}

{% set POLES_HEIGHT = 8 %}

{% macro prop_poles(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['POLES_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, POLES_HEIGHT, platform_height, other_axis_extent=0) }}
	}
{% endmacro %}

{% macro prop_info_panel(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['INFO_PANEL_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 2, platform_height + POLES_HEIGHT - 2, other_axis_extent=3, ) }}
	}
	childsprite {
		sprite: spriteset_things({{ THINGS_IDS['INFO_PANEL_TEXT_' + axis] }});
		{{ use_default_palette() }}
		hide_sprite: pbs_reserved == 0;
	}
{% endmacro %}

{% macro prop_metal_roof(station_platform_side, platform_position, axis, platform_height) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['METAL_ROOF_' + platform_position + '_' + axis] }});
		{{ use_metal_roof_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 6, platform_height + POLES_HEIGHT) }}
	}
{% endmacro %}

{% macro platform_concrete_slabs(station_platform_side, platform_position, axis, modifier='') %}
	// Platform
	building {
		{% if modifier == '' %}
			sprite: spriteset_things({{ THINGS_IDS['PLATFORM_CONCRETE_SLABS_' + axis] }});
		{% else %}
			sprite: spriteset_things({{ THINGS_IDS['PLATFORM_CONCRETE_SLABS_CROSSING_' + platform_position + '_' + axis] }});
		{% endif %}
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 1, 0) }}
	}
	// Platform overlay for continuous platforms (in a way more convenient than using a switch for the platform sprite)
	childsprite {
		sprite: spriteset_things({{ THINGS_IDS['PLATFORM_OVERLAY_CONCRETE_SLABS_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		hide_sprite: platform_number_from_{{ 'start' if platform_position == 'TOP' else 'end' }}(PLATFORM_SAME_STATION) == 0;
	}
{% endmacro %}

{% macro platform_low_asphalt(station_platform_side, platform_position, axis, modifier='') %}
	// Platform
	building {
		{% if modifier == '' %}
			sprite: spriteset_things({{ THINGS_IDS['PLATFORM_LOW_ASPHALT_' + axis] }});
		{% else %}
			sprite: spriteset_things({{ THINGS_IDS['PLATFORM_LOW_ASPHALT_CROSSING_' + platform_position + '_' + axis] }});
		{% endif %}
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 1, 0) }}
	}
	// Platform overlay for continuous platforms (in a way more convenient than using a switch for the platform sprite)
	childsprite {
		sprite: spriteset_things({{ THINGS_IDS['PLATFORM_OVERLAY_LOW_ASPHALT_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		hide_sprite: platform_number_from_{{ 'start' if platform_position == 'TOP' else 'end' }}(PLATFORM_SAME_STATION) == 0;
	}
{% endmacro %}

{% macro platform_high_asphalt(station_platform_side, platform_position, axis) %}
	building {
		sprite: spriteset_things({{ THINGS_IDS['PLATFORM_HIGH_ASPHALT_' + platform_position + '_' + axis] }});
		{{ use_default_palette() }}
		{{ hide_sprite_building(station_platform_side, platform_position) }}
		{{ platform_offsets(platform_position, axis, 3, 0) }}
	}
{% endmacro %}

// Station IDs are made up of the bits (starting from 1, as NML's bitmask function):
// 1: Top platform
// 2: Bottom platform
// 3: High asphalt platform
// 4: Roof
// 5: Underpass
// 6: Bench

{% macro init_passenger_platform_stations() %}
	{% for modifier, modifier_id in [('', 0), ('_CROSSING', 16)] %}
		{% for station_platform_side, platforms_id in STATION_PLATFORM_SIDES %}
			{% set station_name = 'CONCRETE_SLABS' + modifier + '_' + station_platform_side %}

			{% for axis in AXES %}
				spritelayout spritelayout_{{ station_name }}_{{ axis }} {
					{{ ground_rail(axis) }}
					{{ buffers(axis) }}

					{% if modifier == '_CROSSING' %}
						{{ prop_crossing(axis) }}
					{% endif %}
					{{ platform_concrete_slabs(station_platform_side, 'TOP', axis, modifier) }}
					{{ platform_concrete_slabs(station_platform_side, 'BOTTOM', axis, modifier) }}
					{{ cargo_passengers(station_platform_side, 'TOP', axis, 1) }}
					{{ cargo_passengers(station_platform_side, 'BOTTOM', axis, 1) }}

					{#
					{{prop_station_sign(station_platform_side, 'TOP', axis, 1)}}
					{{prop_station_sign(station_platform_side, 'BOTTOM', axis, 1)}}
					{% if station_platform_side != 'BOTH' %}
						{{prop_fence(station_platform_side, 'TOP', axis, 1)}}
						{{prop_fence(station_platform_side, 'BOTTOM', axis, 1)}}
					{% endif %}
					#}
				}
			{% endfor %}

			item(FEAT_STATIONS, station_{{ station_name }}, {{ platforms_id + modifier_id }}) {
				property {
					class: "ap\01\01";
					classname: string(STR_CLASS_NAME_PASSENGERS);
					name: string(STR_STATION_NAME_{{ station_name }});
					cargo_random_triggers: [PASS];
					heights: [1, 1, 1, 1];
				}
				graphics {
					sprite_layouts: [
						spritelayout_{{ station_name }}_X,
						spritelayout_{{ station_name }}_Y
					];
					custom_spritesets: [switch_buffer];

					{% if station_platform_side != 'BOTH' %}
						select_tile_type: switch_tile_type;
					{% endif %}

					random_switch_passengers_{{ '1' if station_platform_side != 'BOTH' else '2'}};
				}
			}
		{% endfor %}
	{% endfor %}

	{% for modifier, modifier_id in [('', 0), ('_CROSSING', 16)] %}
		{% for station_platform_side, platforms_id in STATION_PLATFORM_SIDES %}
			{% set station_name = 'LOW_ASPHALT' + modifier + '_' + station_platform_side %}

			{% for axis in AXES %}
				spritelayout spritelayout_{{ station_name }}_{{ axis }} {
					{{ ground_rail(axis) }}
					{{ buffers(axis) }}

					{% if modifier == '_CROSSING' %}
						{{ prop_crossing(axis) }}
					{% endif %}
					{{ platform_low_asphalt(station_platform_side, 'TOP', axis, modifier) }}
					{{ platform_low_asphalt(station_platform_side, 'BOTTOM', axis, modifier) }}
					{{ cargo_passengers(station_platform_side, 'TOP', axis, 1) }}
					{{ cargo_passengers(station_platform_side, 'BOTTOM', axis, 1) }}

					{#
					{{prop_station_sign(station_platform_side, 'TOP', axis, 1)}}
					{{prop_station_sign(station_platform_side, 'BOTTOM', axis, 1)}}
					{% if station_platform_side != 'BOTH' %}
						{{prop_fence(station_platform_side, 'TOP', axis, 1)}}
						{{prop_fence(station_platform_side, 'BOTTOM', axis, 1)}}
					{% endif %}
					#}
				}
			{% endfor %}

			item(FEAT_STATIONS, station_{{ station_name }}, {{ platforms_id + modifier_id + 32 }}) {
				property {
					class: "ap\01\01";
					classname: string(STR_CLASS_NAME_PASSENGERS);
					name: string(STR_STATION_NAME_{{ station_name }});
					cargo_random_triggers: [PASS];
					heights: [1, 1, 1, 1];
				}
				graphics {
					sprite_layouts: [
						spritelayout_{{ station_name }}_X,
						spritelayout_{{ station_name }}_Y
					];
					custom_spritesets: [switch_buffer];

					{% if station_platform_side != 'BOTH' %}
						select_tile_type: switch_tile_type;
					{% endif %}

					random_switch_passengers_{{ '1' if station_platform_side != 'BOTH' else '2'}};
				}
			}
		{% endfor %}
	{% endfor %}

	{% for (central_furniture, central_furniture_id) in [('', 0), ('_UNDERPASS', 16), ('_BENCH', 32)] %}
		{% for (over_furniture, over_furniture_id) in [('', 0), ('_METAL_ROOF', 8)] %}
		{% for (under_furniture, under_furniture_id) in [('', 0), ('_INFO_PANEL', 64)] %}
			{% for station_platform_side, platforms_id in STATION_PLATFORM_SIDES %}
				{% set station_name = 'HIGH_ASPHALT' + central_furniture + over_furniture + under_furniture + '_' + station_platform_side %}

				{% for axis in AXES %}
					spritelayout spritelayout_{{ station_name }}_{{ axis }} {
						{{ ground_rail(axis) }}
						{{ buffers(axis) }}
						{{ platform_high_asphalt(station_platform_side, 'TOP', axis) }}
						{{ platform_high_asphalt(station_platform_side, 'BOTTOM', axis) }}
						{{ cargo_passengers(station_platform_side, 'TOP', axis, 3) }}
						{{ cargo_passengers(station_platform_side, 'BOTTOM', axis, 3) }}
						{% if central_furniture == '_UNDERPASS' %}
							{{ prop_underpass(station_platform_side, 'TOP', axis, 3) }}
							{{ prop_underpass(station_platform_side, 'BOTTOM', axis, 3) }}
						{% elif central_furniture == '_BENCH' %}
							{{ prop_bench(station_platform_side, 'TOP', axis, 3) }}
							{{ prop_bench(station_platform_side, 'BOTTOM', axis, 3) }}
						{% endif %}
						{% if under_furniture == '_INFO_PANEL' or over_furniture == '_METAL_ROOF' %}
							{{ prop_poles(station_platform_side, 'TOP', axis, 4) }}
							{{ prop_poles(station_platform_side, 'BOTTOM', axis, 4) }}
						{% endif %}
						{% if under_furniture == '_INFO_PANEL' %}
							{{ prop_info_panel(station_platform_side, 'TOP', axis, 4) }}
							{{ prop_info_panel(station_platform_side, 'BOTTOM', axis, 4) }}
						{% endif %}
						{% if over_furniture == '_METAL_ROOF' %}
							{{ prop_metal_roof(station_platform_side, 'TOP', axis, 4) }}
							{{ prop_metal_roof(station_platform_side, 'BOTTOM', axis, 4) }}
						{% endif %}
					}
				{% endfor %}

				item(FEAT_STATIONS, station_{{ station_name }}, {{ central_furniture_id + over_furniture_id + under_furniture_id + platforms_id + 4 }}) {
					property {
						class: "ap\01\01";
						classname: string(STR_CLASS_NAME_PASSENGERS);
						name: string(STR_STATION_NAME_{{ station_name }});
						cargo_random_triggers: [PASS];
						{% if over_furniture == '' %}
							heights: [1, 1, 1, 1];
						{% else %}
							heights: [3, 3, 3, 3];
						{% endif %}
					}
					graphics {
						sprite_layouts: [
							spritelayout_{{ station_name }}_X,
							spritelayout_{{ station_name }}_Y
						];
						custom_spritesets: [switch_buffer];

						{% if station_platform_side != 'BOTH' %}
							select_tile_type: switch_tile_type;
						{% endif %}

						random_switch_passengers_{{ '1' if station_platform_side != 'BOTH' else '2'}};
					}
				}
			{% endfor %}
		{% endfor %}
		{% endfor %}
	{% endfor %}
{% endmacro %}
