<?php function metal_roof(string $axis, string $platform_position, string $layout_position, int $z_off) { ?>
building {
	sprite: spriteset_things(<?= constant("THING_METAL_ROOF_".strtoupper($platform_position)."_{$axis}") ?>);
	<?php use_metal_roof_palette() ?>

	<?php hide_building_logic($platform_position, $layout_position) ?>

	<?php
		$main_axis = strtolower($axis);
		$other_axis = $main_axis === 'x' ? 'y' : 'x';
	?>

	<?= $main_axis ?>offset: 0;
	<?= $other_axis ?>offset: <?= $platform_position === 'top' ? 0 : 11 ?>;
	zoffset: <?= $z_off + POLES_HEIGHT ?>;
	<?= $main_axis ?>extent: 16;
	<?= $other_axis ?>extent: 5;
	zextent: 6;
}
<?php } ?>
